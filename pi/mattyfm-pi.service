[Unit]
Description=MattyFM console (SomaFM, two song decks and the DJ, mixed on the Pi)
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 -u /usr/local/bin/mattyfm-pi /etc/mattyfm.conf
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
