[Unit]
Description=MattyFM receiver (SomaFM + station, crossfaded)
After=network-online.target sound.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 -u /usr/local/bin/mattyfm-pi /etc/mattyfm.conf
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
