[Unit]
Description=MattyFM studio (prepares requests, feeds the station)
After=network-online.target mattyfm-files.service
Wants=mattyfm-files.service

[Service]
WorkingDirectory=%h/dev/mattyfm/studio
Environment=PATH=%h/dev/mattyfm/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=%h/dev/mattyfm/.venv/bin/python -m mattyfm
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
